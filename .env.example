# === Cơ sở dữ liệu ===
POSTGRES_USER=lawvn
POSTGRES_PASSWORD=lawvn-dev
POSTGRES_DB=lawvn
# DATABASE_URL được compose tự đặt cho container api; đặt ở đây khi chạy ngoài Docker:
# DATABASE_URL=postgresql://lawvn:lawvn-dev@localhost:5432/lawvn

# === LLM ===
# Nhà cung cấp chính cho từng loại việc. Xem backend/app/llm/router.py.
LLM_PROVIDER=auto

# Gemini (endpoint tương thích OpenAI của Google).
# Điền tối đa 10 key để xoay vòng khi gặp lỗi/giới hạn.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_LITE=gemini-3.1-flash-lite

# Dahl (endpoint tương thích OpenAI) — nhà cung cấp chính.
# Một key dùng chung cho nhiều model; mỗi câu hỏi gửi song song tới mọi model
# trong DAHL_MODELS và lấy câu trả lời hợp lệ về sớm nhất. Điền tối đa 10 key.
Dahl_token_1=
DAHL_BASE_URL=https://inference.dahl.global/v1
DAHL_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731,zai-org/GLM-5.3-Flash,MiniMaxAI/MiniMax-M2.7
# low = nghĩ ngắn trước khi trả lời (nhanh hơn); để trống để model tự quyết.
DAHL_REASONING_EFFORT=low
# Dahl chưa trả lời sau ngần này giây thì gọi thêm Gemini vào đua (0 = tắt).
DAHL_HEDGE_AFTER=15

# Claude (Anthropic) — dùng cho soạn thảo / báo cáo dài.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# FPT AI Marketplace (tùy chọn — xử lý dữ liệu hàng loạt). Để trống nếu không dùng.
FPT_BASE_URL=https://mkp-api.fptcloud.com
FPT_API_KEY=
FPT_MODEL=gpt-oss-20b

# === Embedding (tự host, không cần key) ===
# hashing = vector băm tất định, chạy ngay không tải model (dùng cho M0/M1).
# bge-m3 / vie-v2 = model thật, bật ở M2 (cần requirements-ml.txt).
EMBEDDER=hashing
EMBED_DIM=1024

# === Rerank ===
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# === Quan sát (tùy chọn) ===
# Bật: 1) docker compose --profile obs up -d langfuse
#      2) mở http://localhost:3002 (cổng nhìn từ trình duyệt), đăng ký tài khoản,
#         tạo project, vào Settings -> API Keys -> Create, dán 2 khoá bên dưới
#      3) LANGFUSE_ENABLED=true, rồi docker compose up -d --force-recreate api
LANGFUSE_ENABLED=false
# LANGFUSE_HOST là địa chỉ api gọi TỪ TRONG CONTAINER, luôn là tên service
# "langfuse", KHÔNG phải localhost:3002 (đó là cổng cho trình duyệt trên máy).
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=change-me-dev-secret
LANGFUSE_SALT=change-me-dev-salt

# === G2: định tuyến theo mức dữ liệu ===
# Ollama chạy trên máy host (OpenAI-compatible); mức A/B CHỈ gọi mô hình này.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Model đã pull trong Ollama.
LOCAL_MODEL=qwen2.5:7b
# Giây chờ tối đa cho một lời gọi mô hình trong máy.
LOCAL_TIMEOUT=120
# Mô hình đám mây cho mức C (mọi endpoint OpenAI-compatible). Đổi mô hình = đổi các dòng này,
# xem docs/huong-dan-doi-mo-hinh.md. Mặc định: Dahl.
CLOUD_LLM_BASE_URL=https://inference.dahl.global/v1
# Thư mục key trong container (docker-compose mount ./keys vào đây, chỉ đọc). Mỗi dòng TÊN=key
# hoặc chỉ key; có nhiều key thì xoay vòng. keys/ nằm trong .gitignore.
CLOUD_LLM_KEYS_DIR=/keys
# Thư mục trống thì đọc key từ biến môi trường có TÊN này (không dán key vào đây).
CLOUD_LLM_API_KEY_ENV=Dahl_token_1
CLOUD_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Thử lần lượt khi model chính lỗi, cách nhau bằng dấu phẩy.
CLOUD_LLM_FALLBACK_MODELS=zai-org/GLM-5.3-Flash,MiniMaxAI/MiniMax-M2.7
# low = nghĩ ngắn; để trống nếu nhà cung cấp không hỗ trợ tham số reasoning_effort.
CLOUD_LLM_REASONING_EFFORT=low
# Số token tối thiểu xin cho mỗi câu trả lời (model có suy nghĩ cần chỗ cho phần nghĩ).
CLOUD_LLM_MIN_TOKENS=8192
# Giây chờ tối đa cho một lời gọi đám mây.
CLOUD_LLM_TIMEOUT=120
# true = mức C gọi đám mây trước, mô hình trong máy làm dự phòng. Mức A/B không bao giờ ra đám mây.
CLOUD_FIRST_FOR_C=false
# Tên cũ, chỉ để tương thích: chỉ dùng khi không có key nào ở hai chỗ trên.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# true = quay lại kế hoạch cũ (đua Dahl rồi Gemini/Claude/FPT); mặc định tắt.
LLM_LEGACY_RACE=false
